{
  "name": "@cairn/node",
  "version": "0.1.0",
  "description": "napi-rs scaffold exposing cairn-client SyncClient<SqliteStorage> to Node.js (feasibility proof, not a polished SDK)",
  "main": "cairn_node.node",
  "scripts": {
    "build": "cargo build --release",
    "build:napi": "napi build --platform --release"
  },
  "napi": {
    "name": "cairn_node",
    "triples": {
      "defaults": true
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unfazed-dev/cairn.git",
    "directory": "sdk/cairn_node"
  },
  "homepage": "https://github.com/unfazed-dev/cairn",
  "bugs": {
    "url": "https://github.com/unfazed-dev/cairn/issues"
  }
}
