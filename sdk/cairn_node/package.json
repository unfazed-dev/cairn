{
  "name": "@cairn/node",
  "version": "0.0.0",
  "description": "napi-rs scaffold exposing cairn-client SyncClient<SqliteStorage> to Node.js (feasibility proof, not a polished SDK)",
  "main": "cairn_node.node",
  "scripts": {
