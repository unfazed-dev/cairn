{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cairn-fixture",
  "version": "0.1.0",
  "identifier": "dev.cairn.fixture",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "cairn fixture (multi-table)", "width": 900, "height": 640 }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "cairn": {
      "syncUrl": "ws://127.0.0.1:8080/sync",
      "tables": ["tasks", "notes"],
      "dbPath": "cairn-fixture.db"
    }
  }
}
