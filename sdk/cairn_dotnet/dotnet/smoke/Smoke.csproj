<Project Sdk="Microsoft.NET.Sdk">

  <!--
  =============================================================================
  Cairn.Smoke — host console E2E for the .NET (C#) binding.
  =============================================================================
  A leaf console app, SEPARATE from ../Cairn.DotNet.csproj (which multi-targets
  the MAUI TFMs net8.0-ios/android/windows/maccatalyst and so cannot `dotnet run`
  on a host without the iOS/Android workloads). This project targets plain
  net8.0 so `dotnet run` works on a host with only the .NET SDK installed.

  It <Compile>s the SAME committed bindgen output (../generated/cairn.cs) the
  MAUI shell ships, and copies the host libcairn_dotnet.dylib next to the
  managed assembly so DllImport("cairn_dotnet") resolves via .NET's app-base
  search path (MS native-library-loading) — no DYLD env, no resolver code.

  Driven by ../../scripts/run-dotnet-e2e.sh (spawns the shared spine, sets
  CAIRN_E2E_PORT). The C# mirror of sdk/cairn_node/smoke_live.cjs.
  =============================================================================
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 is the scaffold floor (matches ../Cairn.DotNet.csproj).
         RollForward=Major lets it execute on a newer installed runtime
         (e.g. the .NET 10 SDK brew ships) without a net8.0 runtime installed. -->
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <RootNamespace>Cairn.Smoke</RootNamespace>
    <AssemblyName>Cairn.Smoke</AssemblyName>
    <!-- Nord bindgen emits IntPtr / Marshal.AllocHGlobal P/Invoke glue. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Only the two files we name; the bindgen output is opt-in, not globbed. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../generated/cairn.cs" />
    <Compile Include="Program.cs" />
    <!-- Ship the host cdylib to the output dir so DllImport resolves from
         app base. run-dotnet-e2e.sh guarantees a release build exists first. -->
    <!-- One of these three exists per host: cargo names the cdylib
         libcairn_dotnet.dylib on macOS, .so on Linux, cairn_dotnet.dll on
         Windows. Only the .dylib was listed, so on Linux CI nothing was
         copied and DllImport("cairn_dotnet") could not resolve. -->
    <None Include="../../target/release/libcairn_dotnet.dylib"
          Condition="Exists('../../target/release/libcairn_dotnet.dylib')"
          CopyToOutputDirectory="PreserveNewest"
          Link="libcairn_dotnet.dylib" />
    <None Include="../../target/release/libcairn_dotnet.so"
          Condition="Exists('../../target/release/libcairn_dotnet.so')"
          CopyToOutputDirectory="PreserveNewest"
          Link="libcairn_dotnet.so" />
    <None Include="../../target/release/cairn_dotnet.dll"
          Condition="Exists('../../target/release/cairn_dotnet.dll')"
          CopyToOutputDirectory="PreserveNewest"
          Link="cairn_dotnet.dll" />
  </ItemGroup>

</Project>
